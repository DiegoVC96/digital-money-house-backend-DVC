# Keycloak para desarrollo local
KEYCLOAK_AUTH_SERVICE_SECRET=replace-with-a-64-character-random-secret
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-admin-password
MYSQL_PASSWORD=change-this-mysql-password
MYSQL_ROOT_PASSWORD=change-this-mysql-root-password
# En AWS conservar 80. Para desarrollo local, usar 8088 si XAMPP ocupa el 80.
FRONTEND_PORT=80
